# Supabase Credentials (Dapatkan dari Project Settings > API di Dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# EMQX Cloud Broker Credentials
NEXT_PUBLIC_EMQX_BROKER_HOST=broker.emqx.io
NEXT_PUBLIC_EMQX_BROKER_PORT=8084
NEXT_PUBLIC_EMQX_USERNAME=
NEXT_PUBLIC_EMQX_PASSWORD=
